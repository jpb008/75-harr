# Copy this file to .env and fill in your own values.
#
# VITE_API_URL is now REQUIRED — the app needs it to reach the backend for
# signup/login, syncing your plan and progress, and closed-app push
# notifications. It's the same Cloudflare Worker URL either way; if you
# already set VITE_PUSH_API_URL from an earlier setup, that's used as a
# fallback, so you don't need to duplicate it.
#
# See server/README.md for how to get this by deploying the Worker to
# Cloudflare (free, no credit card required).

VITE_API_URL=
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_API_URL=
