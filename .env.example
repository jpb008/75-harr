# Copy this file to .env and fill in your own values to enable closed-app
# push notifications. Without these set, the app still works — notifications
# just fall back to only firing while the app is open or backgrounded.
#
# See server/README.md for how to get both values by deploying the push
# server to Cloudflare Workers (free, no credit card required).

VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_API_URL=
